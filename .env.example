# Supabase (من Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx   # سري! متستخدموش ده في كود الفرونت إند أبدًا

# توقيع جلسة تسجيل الدخول (JWT). ولّد قيمة عشوائية طويلة، مثلاً:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_JWT_SECRET=xxxxxxxx

# اختياري: لو شغّال خلف بروكسي/Cloudflare وعايز تاخد IP الحقيقي من هيدر معيّن
TRUST_PROXY=0

# --- المرحلة الانتقالية فقط (الفرونت القديم على InfinityFree لسه بيكلم الباك إند الجديد) ---
# دومين الموقع القديم بالظبط (من غير / في الآخر)، لازم عشان CORS + الكوكي يشتغلوا:
ALLOWED_ORIGIN=https://your-old-site.infinityfreeapp.com
COOKIE_SAMESITE=none
# لما الفرونت ينتقل بالكامل لنفس مشروع Next.js: امسح المتغيّرين دول (أو خلي
# COOKIE_SAMESITE=lax) لأن مفيش cross-origin وقتها.
